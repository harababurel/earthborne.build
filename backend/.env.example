# app
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
PORT="8686"

# database (SQLite)
SQLITE_PATH="./earthborne.db"

# migrations (dbmate)
DATABASE_URL="sqlite:./earthborne.db"
DBMATE_MIGRATIONS_DIR="src/db/migrations"
DBMATE_SCHEMA_FILE="src/db/schema.sql"

# card data ingestion
# Usage: CARD_DATA_DIR=/path/to/rangers-card-data npm run ingest:cards -w backend
CARD_DATA_DIR="/path/to/rangers-card-data"

# card image serving — directory downloaded by scripts/download-images.ts
# Structure: {IMAGE_DIR}/{pack_id}/{code}.jpg
# Usage: CARD_DATA_DIR=/path/to/rangers-card-data IMAGE_DIR=/path/to/earthborne.images npm run download:images -w backend
IMAGE_DIR="/path/to/earthborne.images"

# admin API key
ADMIN_API_KEY="change-me-to-a-long-random-secret"

# sessions
SESSION_COOKIE_NAME="eb_session"
SESSION_EXPIRY_HOURS="720"

# email
FROM_EMAIL="noreply@earthborne.build"
FROM_NAME="earthborne.build"

# SMTP / MailCrab
# When SMTP_HOST is unset, emails are logged by ConsoleMailer.
# For local MailCrab, uncomment these:
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""

# Cloudflare Turnstile
# Leave unset or empty to disable signup captcha verification.
# TURNSTILE_SECRET_KEY=""
