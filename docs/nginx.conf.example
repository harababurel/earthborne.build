# earthborne.build — example nginx server block
#
# Place in:    /etc/nginx/sites-available/earthborne.build
# Enable with: ln -s /etc/nginx/sites-available/earthborne.build \
#                    /etc/nginx/sites-enabled/earthborne.build
# Reload with: nginx -t && systemctl reload nginx
#
# Adjust:
#   - server_name   → your domain
#   - root          → absolute path to frontend/dist on this machine
#   - proxy_pass    → backend port (default 8686, set via PORT in backend/.env)

server {
    listen 80;
    listen [::]:80;
    server_name earthborne.build;

    add_header Strict-Transport-Security "max-age=300" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' plausible.io; connect-src 'self' plausible.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self'; frame-ancestors 'none'" always;

    # Frontend — built static files
    root /srv/earthborne.build/frontend/dist;
    index index.html;

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA routing: unknown paths fall back to index.html
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    # Card images — proxied to backend which reads from IMAGE_DIR on disk.
    # Images are immutably cached (card art never changes for a given code).
    location /images/ {
        proxy_pass         http://127.0.0.1:8686;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_cache_valid  200 1y;
        add_header         Cache-Control "public, max-age=31536000, immutable";
    }

    # Backend API proxy
    location ~ ^/(v2|version|admin|up)(/|$) {
        proxy_pass         http://127.0.0.1:8686;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Compression
    gzip            on;
    gzip_vary       on;
    gzip_types      text/plain text/css application/json
                    application/javascript text/xml application/xml
                    text/javascript image/svg+xml;

    # Cache Vite-built assets forever; filenames include content hashes.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
}
