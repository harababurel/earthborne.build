# Base URL of the earthborne.build backend API.
# In production this is typically the same origin (empty string = relative URLs),
# or an absolute URL if the backend runs on a different host/port.
# Note: Use 'localhost' rather than '127.0.0.1' so SameSite cookies work correctly.
VITE_API_URL="http://localhost:8686"

# Legacy API base URL — currently used only for public share JSON links.
# Point to the same backend as VITE_API_URL.
VITE_API_LEGACY_URL="http://localhost:8686"

# Base URL for card image serving. In development, images are served by the
# backend at /images/:code. Set to the backend URL + /images path.
# In production, nginx can proxy /images/ to the backend, so this can be
# a relative path or the same origin.
VITE_CARD_IMAGE_URL="http://localhost:8686/images"

# Cloudflare Turnstile site key for login / signup pages.
VITE_TURNSTILE_SITE_KEY=""

# Optional contact email shown in account privacy settings.
VITE_ADMIN_EMAIL=""

# Name shown in the browser tab title.
VITE_PAGE_NAME="earthborne.build"

# Optional app build identifier shown in Settings. If unset, Vite will use
# the current git commit SHA when the frontend starts/builds.
VITE_APP_BUILD=""

# Optional build timestamp and commit URL shown in Settings. If unset, Vite
# will use the commit timestamp and derive the GitHub commit URL.
VITE_APP_BUILD_TIME=""
VITE_APP_BUILD_URL=""
